# Copy of the bot's settings. On Railway you do NOT need this file —
# you will paste the real values into Railway's Variables tab
# (see RAILWAY-SECRETS.txt and STEP-BY-STEP-GUIDE.md).

# Discord bot token (from your Discord developer app)
DISCORD_TOKEN=paste-your-discord-token

# Daily brief timezone
BRIEF_TIMEZONE=Asia/Karachi

# Gmail (used for reading the inbox; sending goes through Zapier)
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Zapier MCP server URL (connects HubSpot / Apollo / Gmail / Brevo / Facebook)
ZAPIER_MCP_URL=https://mcp.zapier.com/api/mcp/mcp?serverId=xxxx

# Z.ai brain connection (the 5 ZAI_* values come with this package)
ZAI_BASE_URL=
ZAI_API_KEY=
ZAI_CHAT_ID=
ZAI_TOKEN=
ZAI_USER_ID=
